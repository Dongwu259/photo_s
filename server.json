{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Dongwu259/photo-s",
  "title": "PhotoS",
  "description": "Batch photo processing: compress, convert, EXIF, rename, dedup, cull, galleries",
  "repository": {
    "url": "https://github.com/Dongwu259/photo_s",
    "source": "github"
  },
  "version": "2.3.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "photo-s-tools",
      "version": "2.3.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "photo-s-tools[mcp]"
        },
        {
          "type": "positional",
          "value": "photo-s"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
